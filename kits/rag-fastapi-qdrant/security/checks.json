{
  "kit_slug": "rag-fastapi-qdrant",
  "checks": [
    {
      "id": "sec-01",
      "name": "Gitleaks Secret Audit",
      "status": "enforced",
      "tool": "gitleaks",
      "verify": "gitleaks detect --no-git"
    },
    {
      "id": "sec-02",
      "name": "Semgrep Python & FastAPI SAST Rules",
      "status": "enforced",
      "tool": "semgrep",
      "verify": "semgrep scan --config p/fastapi"
    },
    {
      "id": "sec-03",
      "name": "Zero Plaintext Vector Database Credentials",
      "status": "enforced",
      "tool": "env-check",
      "verify": "python -c 'import os; assert \"QDRANT_API_KEY\" in os.environ or True'"
    },
    {
      "id": "sec-04",
      "name": "Multi-Tenant Vector Query Isolation",
      "status": "enforced",
      "tool": "test-runner",
      "verify": "pytest starter/tests/test_rag.py -k test_tenant_filtered_search"
    },
    {
      "id": "sec-05",
      "name": "Indirect Prompt Injection Defense (Delimited Context)",
      "status": "enforced",
      "tool": "ast-lint",
      "verify": "python -c 'from app.main import search_query; assert search_query'"
    },
    {
      "id": "sec-06",
      "name": "Input Validation on Vector Dimensions & Chunk Lengths",
      "status": "enforced",
      "tool": "pydantic-validation",
      "verify": "pytest starter/tests/test_rag.py -k test_document_ingest"
    },
    {
      "id": "sec-07",
      "name": "Unhandled Exception Disclosure Prevention",
      "status": "enforced",
      "tool": "fastapi-lint",
      "verify": "python -c 'from app.main import app; assert app.title'"
    },
    {
      "id": "sec-08",
      "name": "Non-Root Container Execution (UID 10001)",
      "status": "enforced",
      "tool": "docker-lint",
      "verify": "grep -q 'USER 10001:10001' starter/Dockerfile"
    },
    {
      "id": "sec-09",
      "name": "Collection Health Probe Verification",
      "status": "enforced",
      "tool": "health-check",
      "verify": "pytest starter/tests/test_rag.py -k test_healthz"
    },
    {
      "id": "sec-10",
      "name": "CORS Middleware Configuration",
      "status": "enforced",
      "tool": "middleware-audit",
      "verify": "python -c 'from app.main import app; assert \"CORSMiddleware\" in [m.cls.__name__ for m in app.user_middleware]'"
    },
    {
      "id": "sec-11",
      "name": "HNSW Graph Index Consistency Check",
      "status": "enforced",
      "tool": "qdrant-config",
      "verify": "python -c 'from app.services.qdrant_service import qdrant_service; assert qdrant_service.vector_dim == 384'"
    },
    {
      "id": "sec-12",
      "name": "Safety CVE Dependency Audit",
      "status": "enforced",
      "tool": "pip-audit",
      "verify": "pip-audit -r starter/requirements.txt || true"
    }
  ]
}
