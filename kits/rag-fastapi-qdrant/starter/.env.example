# RAG FastAPI + Qdrant Service Configuration
APP_NAME=rag-fastapi-qdrant
APP_ENV=development
DEBUG=True
PORT=8000

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
QDRANT_API_KEY=

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50
