# Generated by tools/build_dockerignore.py. Do not edit by hand.
#
# The build context is a security boundary: anything listed here cannot be
# copied into an image even by a broad `COPY . .`.

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.npmrc
.netrc

# Version control — carries deleted secrets in its history
.git
.gitignore
.gitattributes
.github/

# Build recipe itself — never needed inside the image
Dockerfile
Dockerfile.*
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs and local databases
*.log
logs/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# python build artifacts and installed dependencies
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
instance/
.tox/
