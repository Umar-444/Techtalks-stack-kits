# LlamaIndex + PostgreSQL pgvector Service Configuration
APP_NAME=rag-llamaindex-pgvector
APP_ENV=development
DEBUG=True
PORT=8000

# PostgreSQL pgvector Database
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
TABLE_NAME=data_rag_embeddings

# Vector Dimensions
EMBEDDING_DIM=384
CHUNK_SIZE=512
CHUNK_OVERLAP=64
