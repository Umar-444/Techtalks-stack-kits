{
  "kit": "laravel-livewire-postgresql",
  "version": "1.0.0",
  "total_controls": 12,
  "categories": [
    {
      "name": "Livewire Component & State Security",
      "controls": [
        {
          "id": "LW-01",
          "name": "Checksum validation on all public component properties",
          "status": "enforced",
          "test": "tests/Feature/Security/LivewireChecksumTest.php"
        },
        {
          "id": "LW-02",
          "name": "Server-side authorization check before executing component actions",
          "status": "enforced",
          "test": "tests/Feature/Security/LivewireActionPolicyTest.php"
        },
        {
          "id": "LW-03",
          "name": "Explicit property binding whitelist preventing mass assignment",
          "status": "enforced",
          "test": "tests/Feature/Security/LivewireMassAssignmentTest.php"
        },
        {
          "id": "LW-04",
          "name": "Wire:model input debouncing and length validation",
          "status": "enforced",
          "test": "tests/Feature/Security/LivewireDebounceTest.php"
        },
        {
          "id": "LW-05",
          "name": "Rate limiting on sensitive component actions",
          "status": "enforced",
          "test": "tests/Feature/Security/LivewireRateLimitTest.php"
        }
      ]
    },
    {
      "name": "Authentication & Session Protection",
      "controls": [
        {
          "id": "AUTH-01",
          "name": "Argon2id password hashing with work factor >= 12",
          "status": "enforced",
          "test": "tests/Feature/Security/PasswordSecurityTest.php"
        },
        {
          "id": "AUTH-02",
          "name": "Strict session fixation prevention on Livewire login events",
          "status": "enforced",
          "test": "tests/Feature/Security/SessionFixationTest.php"
        },
        {
          "id": "AUTH-03",
          "name": "Secure session cookie flags: Secure, HttpOnly, SameSite=Lax",
          "status": "enforced",
          "test": "tests/Feature/Security/CookieFlagsTest.php"
        }
      ]
    },
    {
      "name": "Data Layer & PostgreSQL Hardening",
      "controls": [
        {
          "id": "DATA-01",
          "name": "Strict parameterized queries on all Eloquent scopes",
          "status": "enforced",
          "test": "tests/Feature/Security/SqlInjectionTest.php"
        },
        {
          "id": "DATA-02",
          "name": "PostgreSQL native UUID primary keys on all models",
          "status": "enforced",
          "test": "tests/ArchTest.php"
        }
      ]
    },
    {
      "name": "CI & Supply Chain Guardrails",
      "controls": [
        {
          "id": "CI-01",
          "name": "Gitleaks secret detection in GitHub Actions",
          "status": "enforced",
          "workflow": ".github/workflows/security.yml"
        },
        {
          "id": "CI-02",
          "name": "Semgrep OWASP rule scans on pull requests",
          "status": "enforced",
          "workflow": ".github/workflows/security.yml"
        }
      ]
    }
  ]
}
