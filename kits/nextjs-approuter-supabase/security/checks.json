{
  "kit": "nextjs-approuter-supabase",
  "version": "1.0.0",
  "total_controls": 12,
  "categories": [
    {
      "name": "Row Level Security (RLS) & Database Layer",
      "controls": [
        {
          "id": "RLS-01",
          "name": "Mandatory Row Level Security enabled on all PostgreSQL tables",
          "status": "enforced",
          "test": "supabase/migrations/"
        },
        {
          "id": "RLS-02",
          "name": "Strict auth.uid() = user_id tenant isolation policies",
          "status": "enforced",
          "test": "supabase/migrations/"
        },
        {
          "id": "RLS-03",
          "name": "Service role key isolated from client-side bundles (no NEXT_PUBLIC_)",
          "status": "enforced",
          "test": "starter/.env.example"
        },
        {
          "id": "RLS-04",
          "name": "Compound index coverage on user_id and timestamp columns",
          "status": "enforced",
          "test": "supabase/migrations/"
        }
      ]
    },
    {
      "name": "Server Actions & Input Validation",
      "controls": [
        {
          "id": "ACT-01",
          "name": "Strict Zod schema validation on all Server Action inputs",
          "status": "enforced",
          "test": "src/app/actions.ts"
        },
        {
          "id": "ACT-02",
          "name": "Next.js automatic CSRF Origin header verification",
          "status": "enforced",
          "test": "src/app/actions.ts"
        },
        {
          "id": "ACT-03",
          "name": "Revalidation of mutated paths via revalidatePath()",
          "status": "enforced",
          "test": "src/app/actions.ts"
        }
      ]
    },
    {
      "name": "Authentication & Session Protection",
      "controls": [
        {
          "id": "AUTH-01",
          "name": "Supabase SSR cookie security flags (HttpOnly, Secure, SameSite=Lax)",
          "status": "enforced",
          "test": "src/lib/supabase/server.ts"
        },
        {
          "id": "AUTH-02",
          "name": "Middleware session refresh and PKCE flow enforcement",
          "status": "enforced",
          "test": "src/middleware.ts"
        },
        {
          "id": "AUTH-03",
          "name": "Server Component direct session verification",
          "status": "enforced",
          "test": "src/app/page.tsx"
        }
      ]
    },
    {
      "name": "CI & Supply Chain Guardrails",
      "controls": [
        {
          "id": "CI-01",
          "name": "Gitleaks secret detection in GitHub Actions",
          "status": "enforced",
          "workflow": ".github/workflows/security.yml"
        },
        {
          "id": "CI-02",
          "name": "Semgrep security scanning for TypeScript and Next.js rules",
          "status": "enforced",
          "workflow": ".github/workflows/security.yml"
        }
      ]
    }
  ]
}
