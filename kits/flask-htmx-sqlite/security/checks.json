    {
      "id": "sec-06",
      "name": "Non-Root Container Execution (UID 10001)",
      "status": "enforced",
      "tool": "docker-lint",
      "verify": "grep -q 'USER 10001:10001' starter/Dockerfile"
    },
    {
      "id": "sec-07",
      "name": "Health Probe & WAL Liveness Check Endpoint",
      "status": "enforced",
      "tool": "test-runner",
      "verify": "grep -q '/health' starter/app/routes.py"
    },
    {
