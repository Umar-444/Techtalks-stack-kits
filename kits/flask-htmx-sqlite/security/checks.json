    },
    {
      "id": "sec-05",
      "name": "Flask-WTF CSRF Protection with HTMX Header Forwarding",
      "status": "enforced",
      "tool": "csrf-validator",
      "verify": "grep -q 'CSRFProtect' starter/app/__init__.py"
