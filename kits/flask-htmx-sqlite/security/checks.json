    {
      "id": "sec-03",
      "name": "SQLite Strict Parameterized Queries (Zero SQL Injection)",
      "status": "enforced",
      "tool": "static-analysis",
      "verify": "grep -q '?' starter/app/routes.py"
    },
    {
      "id": "sec-04",
      "name": "Cross-Site Scripting (XSS) Immunity via Jinja2 Auto-Escaping",
      "status": "enforced",
      "tool": "template-linter",
