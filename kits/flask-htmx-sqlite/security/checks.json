      "name": "SQLite WAL Mode Non-Blocking Concurrency",
      "status": "enforced",
      "tool": "db-pragma-audit",
      "verify": "grep -q 'PRAGMA journal_mode = WAL' starter/app/db.py"
    },
    {
      "id": "sec-09",
      "name": "SQLite Lock Contention Defense (5000ms Busy Timeout)",
      "status": "enforced",
      "tool": "db-pragma-audit",
      "verify": "grep -q 'PRAGMA busy_timeout = 5000' starter/app/db.py"
    },
    {
      "id": "sec-10",
      "name": "HTTP Security Headers (nosniff, DENY, strict-origin)",
      "status": "enforced",
      "tool": "middleware-audit",
      "verify": "grep -q 'X-Content-Type-Options' starter/app/__init__.py"
    },
    {
      "id": "sec-11",
      "name": "Secure Session Secret Key from Environment",
      "status": "enforced",
      "tool": "config-audit",
      "verify": "grep -q 'SECRET_KEY' starter/.env.example"
