{
    "name": "techtalks/laravel-filament-postgresql-starter",
    "type": "project",
    "description": "TechTalks Stack Kit Starter: Laravel 12/13 + Filament 4/3 + PostgreSQL",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "filament/filament": "^3.2 || ^4.0",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/horizon": "^5.24",
        "spatie/laravel-permission": "^6.9"
    },
    "require-dev": {
        "larastan/larastan": "^2.9 || ^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
