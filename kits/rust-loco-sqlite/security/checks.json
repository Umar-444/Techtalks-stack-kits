{
  "kit": "rust-loco-sqlite",
  "version": "1.0.0",
  "total_controls": 12,
  "categories": [
    {
      "name": "Memory Safety & Zero-Trust Rust Compiler Defenses",
      "controls": [
        {
          "id": "RUST-LOCO-01",
          "name": "Zero unsafe code policy enforced via #![deny(unsafe_code)]",
          "status": "enforced",
          "rule": "rules/source/01-framework-architecture-and-standards.md"
        },
        {
          "id": "RUST-LOCO-02",
          "name": "Strict Serde JSON deserialization with input length bounds and validator crate",
          "status": "enforced",
          "test": "starter/src/controllers/items.rs"
        },
        {
          "id": "RUST-LOCO-03",
          "name": "SeaORM parameterized queries eliminating SQL injection vulnerabilities",
          "status": "enforced",
          "tool": "sea-orm"
        }
      ]
    },
    {
      "name": "Database Hardening & Concurrency Protection",
      "controls": [
        {
          "id": "DB-LOCO-01",
          "name": "SQLite WAL mode (PRAGMA journal_mode=WAL) eliminating concurrency lock contention",
          "status": "enforced",
          "rule": "rules/source/02-seaorm-and-sqlite-wal-configuration.md"
        },
        {
          "id": "DB-LOCO-02",
          "name": "SQLite busy timeout (5000ms) preventing lock starvation deadlocks",
          "status": "enforced",
          "rule": "rules/source/02-seaorm-and-sqlite-wal-configuration.md"
        },
        {
          "id": "DB-LOCO-03",
          "name": "Dedicated persistent volume storage with unprivileged user ownership",
          "status": "enforced",
          "docker": "starter/Dockerfile: VOLUME [/app/storage]"
        }
      ]
    },
    {
      "name": "Network & Middleware Security Layers",
      "controls": [
        {
          "id": "NET-LOCO-01",
          "name": "Strict CORS origin whitelist in Loco YAML config (no wildcard *)",
          "status": "enforced",
          "rule": "rules/source/04-security-cors-and-authentication.md"
        },
        {
          "id": "NET-LOCO-02",
          "name": "Loco JWT authenticator middleware protecting authenticated routes",
          "status": "enforced",
          "rule": "rules/source/04-security-cors-and-authentication.md"
        },
        {
          "id": "NET-LOCO-03",
          "name": "Pagination bounds enforcement (clamp 1..100) preventing memory exhaustion",
          "status": "enforced",
          "rule": "rules/source/03-controller-routing-and-views.md"
        }
      ]
    },
    {
      "name": "Container & Supply Chain Hardening",
      "controls": [
        {
          "id": "OPS-LOCO-01",
          "name": "Liveness probe health endpoint (/healthz) returning HTTP 200 OK",
          "status": "enforced",
          "endpoint": "GET /healthz"
        },
        {
          "id": "OPS-LOCO-02",
          "name": "Non-root execution inside multi-stage Alpine container (USER 10001:10001)",
          "status": "enforced",
          "docker": "starter/Dockerfile: USER 10001:10001"
        },
        {
          "id": "OPS-LOCO-03",
          "name": "Gitleaks secret detection and cargo-audit dependency scanning in CI",
          "status": "enforced",
          "workflow": ".github/workflows/security.yml"
        }
      ]
    }
  ]
}
