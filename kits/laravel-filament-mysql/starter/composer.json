{
    "name": "techtalks/laravel-filament-mysql-starter",
    "type": "project",
    "description": "Production-ready Laravel 12 + Filament 4 + MySQL 8.4 LTS starter kit",
    "license": "MIT",
    "require": {
        "php": "^8.3 || ^8.4",
        "filament/filament": "^3.2 || ^4.0",
        "laravel/framework": "^11.0 || ^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-laravel": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "test": "pest"
    }
}
