{
    "name": "techtalks/laravel-mongodb-starter",
    "type": "project",
    "description": "TechTalks Stack Kit Starter: Laravel 12 + MongoDB 7+ (NoSQL)",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "mongodb/laravel-mongodb": "^5.0 || ^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
