{
    "name": "techtalks/laravel-mongodb-starter",
    "type": "project",
    "description": "TechTalks Stack Kit Starter: Laravel 12 + MongoDB 7+ (NoSQL)",
    "license": "MIT",
    "require": {
        "php": "^8.3 || ^8.4",
        "ext-mongodb": "*",
        "laravel/framework": "^12.0",
        "mongodb/laravel-mongodb": "^5.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
