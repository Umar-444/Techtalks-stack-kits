{
  "kit_slug": "security-passkeys-auth",
  "checks": [
    {
      "id": "sec-01",
      "name": "Gitleaks Secret Audit",
      "status": "enforced",
      "tool": "gitleaks",
      "verify": "gitleaks detect --no-git"
    },
    {
      "id": "sec-02",
      "name": "Semgrep SAST TypeScript Code Scan",
      "status": "enforced",
      "tool": "semgrep",
      "verify": "semgrep scan --config p/security-code-scan"
    },
    {
      "id": "sec-03",
      "name": "Explicit CORS Policy (Zero Wildcard Origins)",
      "status": "enforced",
      "tool": "code-lint",
      "verify": "grep -q 'origin: allowedOrigins' starter/src/server.ts"
    },
    {
      "id": "sec-04",
      "name": "Cryptographic Challenge Expiration (< 120s TTL)",
      "status": "enforced",
      "tool": "static-analysis",
      "verify": "grep -q 'ttlSeconds' starter/src/db.ts"
    },
    {
      "id": "sec-05",
      "name": "Single-Use Challenge Consumption (Replay Attack Defense)",
      "status": "enforced",
      "tool": "static-analysis",
      "verify": "grep -q 'challenges.delete' starter/src/db.ts"
    },
    {
      "id": "sec-06",
      "name": "Non-Root Container Execution (UID 10001)",
      "status": "enforced",
      "tool": "docker-lint",
      "verify": "grep -q 'USER 10001:10001' starter/Dockerfile"
    },
    {
      "id": "sec-07",
      "name": "Health Probe & WebAuthn Status Endpoint",
      "status": "enforced",
      "tool": "test-runner",
      "verify": "grep -q '/health' starter/src/server.ts"
    },
    {
      "id": "sec-08",
      "name": "Authenticator Cloning Defense (Counter Rollback Detection)",
      "status": "enforced",
      "tool": "static-analysis",
      "verify": "grep -q 'newCounter <= passkey.counter' starter/src/server.ts"
    },
    {
      "id": "sec-09",
      "name": "Session Fixation Defense (Token Rotation Post-Auth)",
      "status": "enforced",
      "tool": "static-analysis",
      "verify": "grep -q 'deleteCookie' starter/src/server.ts"
    },
    {
      "id": "sec-10",
      "name": "Hardened Cookie Attributes (HttpOnly, SameSite=Lax)",
      "status": "enforced",
      "tool": "code-lint",
      "verify": "grep -q 'httpOnly: true' starter/src/server.ts"
    },
    {
      "id": "sec-11",
      "name": "Strict Origin and RP ID Verification",
      "status": "enforced",
      "tool": "static-analysis",
      "verify": "grep -q 'expectedOrigin: EXPECTED_ORIGIN' starter/src/server.ts"
    },
    {
      "id": "sec-12",
      "name": "Token-Light Efficiency Verification (Tier A+ Standard)",
      "tool": "eval-runner",
      "status": "enforced",
      "verify": "python evals/runner.py --kit security-passkeys-auth"
    }
  ]
}
