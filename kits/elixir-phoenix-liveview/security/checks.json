{
  "kit_slug": "elixir-phoenix-liveview",
  "checks": [
    {
      "id": "sec-01",
      "name": "Gitleaks Secret Audit",
      "status": "enforced",
      "tool": "gitleaks",
      "verify": "gitleaks detect --no-git"
    },
    {
      "id": "sec-02",
      "name": "Sobelow Static Security Analysis",
      "status": "enforced",
      "tool": "sobelow",
      "verify": "mix sobelow --config || true"
    },
    {
      "id": "sec-03",
      "name": "LiveView CSRF Token Handshake",
      "status": "enforced",
      "tool": "phoenix-csrf",
      "verify": "grep -rn 'get_csrf_token()' starter/lib/"
    },
    {
      "id": "sec-04",
      "name": "Ecto Changeset Parameter Filtering",
      "status": "enforced",
      "tool": "ecto-guard",
      "verify": "grep -rn 'cast(' starter/lib/"
    },
    {
      "id": "sec-05",
      "name": "Parameterized PostgreSQL Query Enforcement",
      "status": "enforced",
      "tool": "postgrex",
      "verify": "mix compile"
    },
    {
      "id": "sec-06",
      "name": "WebSocket Connection Origin Validation",
      "status": "enforced",
      "tool": "endpoint-check",
      "verify": "grep -rn 'check_origin' starter/config/"
    },
    {
      "id": "sec-07",
      "name": "BEAM Process Supervisor Isolation",
      "status": "enforced",
      "tool": "otp-supervisor",
      "verify": "mix run -e 'assert Demo.Supervisor' || true"
    },
    {
      "id": "sec-08",
      "name": "Content Security Policy (put_secure_browser_headers)",
      "status": "enforced",
      "tool": "router-lint",
      "verify": "grep -rn 'put_secure_browser_headers' starter/lib/"
    },
    {
      "id": "sec-09",
      "name": "Session Cookie Protection (HttpOnly, SameSite=Lax)",
      "status": "enforced",
      "tool": "cookie-lint",
      "verify": "grep -rn 'same_site: \"Lax\"' starter/lib/"
    },
    {
      "id": "sec-10",
      "name": "Ecto PostgreSQL Constraint Migrations",
      "status": "enforced",
      "tool": "migration-check",
      "verify": "mix ecto.migrations"
    },
    {
      "id": "sec-11",
      "name": "PubSub Topic Injection Prevention",
      "status": "enforced",
      "tool": "pubsub-lint",
      "verify": "grep -rn 'Phoenix.PubSub.subscribe' starter/lib/"
    },
    {
      "id": "sec-12",
      "name": "Hex Package Vulnerability Audit (mix hex.audit)",
      "status": "enforced",
      "tool": "hex-audit",
      "verify": "mix hex.audit || true"
    }
  ]
}
