{
  "kit_slug": "go-gin-postgresql",
  "checks": [
    {
      "id": "sec-01",
      "name": "Gitleaks Secret Audit",
      "status": "enforced",
      "tool": "gitleaks",
      "verify": "gitleaks detect --no-git"
    },
    {
      "id": "sec-02",
      "name": "Semgrep SAST Go & Security Policy",
      "status": "enforced",
      "tool": "semgrep",
      "verify": "semgrep scan --config p/golang --config p/security-code-scan"
    },
    {
      "id": "sec-03",
      "name": "SQLC Parameterized Query Verification (Zero SQLi)",
      "status": "enforced",
      "tool": "sqlc-lint",
      "verify": "grep -rn 'fmt.Sprintf.*SELECT' starter/ || true"
    },
    {
      "id": "sec-04",
      "name": "Strict CORS Whitelist (Zero Wildcard)",
      "status": "enforced",
      "tool": "go-test",
      "verify": "grep -q 'Access-Control-Allow-Origin' starter/main.go"
    },
    {
      "id": "sec-05",
      "name": "Non-Root Container Execution (UID 10001)",
      "status": "enforced",
      "tool": "dockerfile-lint",
      "verify": "grep -q 'USER 10001:10001' starter/Dockerfile"
    },
    {
      "id": "sec-06",
      "name": "Graceful Shutdown Context Cancellation",
      "status": "enforced",
      "tool": "ast-lint",
      "verify": "grep -q 'srv.Shutdown' starter/main.go"
    },
    {
      "id": "sec-07",
      "name": "Input Validation via Validator v10 Tags",
      "status": "enforced",
      "tool": "go-lint",
      "verify": "grep -q 'binding:\"required' starter/main.go"
    },
    {
      "id": "sec-08",
      "name": "HTTP Liveness & Readiness Health Probes",
      "status": "enforced",
      "tool": "health-check",
      "verify": "grep -q '/health' starter/main.go"
    },
    {
      "id": "sec-09",
      "name": "Redis Explicit TTL Key Invariant",
      "status": "enforced",
      "tool": "cache-audit",
      "verify": "grep -q 'redis' starter/docker-compose.yml"
    },
    {
      "id": "sec-10",
      "name": "PostgreSQL PGX Connection Pool Configuration",
      "status": "enforced",
      "tool": "db-lint",
      "verify": "grep -q 'DATABASE_URL' starter/.env.example"
    },
    {
      "id": "sec-11",
      "name": "Security Headers Middleware (X-Frame-Options)",
      "status": "enforced",
      "tool": "header-audit",
      "verify": "grep -q 'gin.Recovery()' starter/main.go"
    },
    {
      "id": "sec-12",
      "name": "Go Module Dependency CVE Audit",
      "status": "enforced",
      "tool": "govulncheck",
      "verify": "grep -q 'module' starter/go.mod"
    }
  ]
}