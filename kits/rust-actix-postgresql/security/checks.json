{
  "kit": "rust-actix-postgresql",
  "version": "1.0.0",
  "total_controls": 12,
  "categories": [
    {
      "name": "Memory Safety & Zero-Trust Rust Compiler Defenses",
      "controls": [
        {
          "id": "RUST-ACTIX-01",
          "name": "Zero unsafe code policy enforced via #![deny(unsafe_code)]",
          "status": "enforced",
          "rule": "rules/source/01-framework-architecture-and-standards.md"
        },
        {
          "id": "RUST-ACTIX-02",
          "name": "Strict Serde JSON deserialization with input length bounds and validator crate",
          "status": "enforced",
          "test": "starter/src/dtos.rs"
        },
        {
          "id": "RUST-ACTIX-03",
          "name": "SeaORM parameterized queries eliminating SQL injection vulnerabilities",
          "status": "enforced",
          "tool": "sea-orm"
        }
      ]
    },
    {
      "name": "Database Hardening & Connection Protection",
      "controls": [
        {
          "id": "DB-ACTIX-01",
          "name": "Bounded connection pool limits via ConnectOptions (max 25 connections)",
          "status": "enforced",
          "rule": "rules/source/02-seaorm-entities-and-postgresql-pooling.md"
        },
        {
          "id": "DB-ACTIX-02",
          "name": "Strict acquire timeout (3s) preventing connection starvation deadlocks",
          "status": "enforced",
          "rule": "rules/source/02-seaorm-entities-and-postgresql-pooling.md"
        },
        {
          "id": "DB-ACTIX-03",
          "name": "Atomic transaction encapsulation via db.transaction for ACID guarantees",
          "status": "enforced",
          "rule": "rules/source/02-seaorm-entities-and-postgresql-pooling.md"
        }
      ]
    },
    {
      "name": "Network & Middleware Security Layers",
      "controls": [
        {
          "id": "NET-ACTIX-01",
          "name": "Strict CORS origin whitelist parsed from ALLOWED_ORIGINS (no wildcard *)",
          "status": "enforced",
          "test": "starter/src/lib.rs: configure_cors"
        },
        {
          "id": "NET-ACTIX-02",
          "name": "Unified AppError boundary preventing database schema disclosure",
          "status": "enforced",
          "test": "starter/src/errors.rs: AppError"
        },
        {
          "id": "NET-ACTIX-03",
          "name": "Pagination bounds enforcement (clamp 1..100) preventing query DoS",
          "status": "enforced",
          "test": "starter/src/handlers.rs: list_items"
        }
      ]
    },
    {
      "name": "Container & Supply Chain Hardening",
      "controls": [
        {
          "id": "OPS-ACTIX-01",
          "name": "Liveness probe health endpoint (/healthz) returning HTTP 200 OK",
          "status": "enforced",
          "endpoint": "GET /healthz"
        },
        {
          "id": "OPS-ACTIX-02",
          "name": "Non-root execution inside multi-stage Alpine container (USER 10001:10001)",
          "status": "enforced",
          "docker": "starter/Dockerfile: USER 10001:10001"
        },
        {
          "id": "OPS-ACTIX-03",
          "name": "Gitleaks secret detection and cargo-audit dependency scanning in CI",
          "status": "enforced",
          "workflow": ".github/workflows/security.yml"
        }
      ]
    }
  ]
}
