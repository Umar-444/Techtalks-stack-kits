{
  "kit_slug": "go-fiber-api",
  "checks": [
    {
      "id": "sec-01",
      "name": "Gitleaks Secret Audit",
      "status": "enforced",
      "tool": "gitleaks",
      "verify": "gitleaks detect --no-git"
    },
    {
      "id": "sec-02",
      "name": "Semgrep SAST Go & Security Policy",
      "status": "enforced",
      "tool": "semgrep",
      "verify": "semgrep scan --config p/golang --config p/security-code-scan"
    },
    {
      "id": "sec-03",
      "name": "Fasthttp Buffer Copy Invariant (Zero Pointer Races)",
      "status": "enforced",
      "tool": "go-race",
      "verify": "grep -q 'strings.Clone' starter/main.go"
    },
    {
      "id": "sec-04",
      "name": "Strict CORS Whitelist (Zero Wildcard)",
      "status": "enforced",
      "tool": "go-test",
      "verify": "grep -q 'cors.Config' starter/main.go"
    },
    {
      "id": "sec-05",
      "name": "Non-Root Container Execution (UID 10001)",
      "status": "enforced",
      "tool": "dockerfile-lint",
      "verify": "grep -q 'USER 10001:10001' starter/Dockerfile"
    },
    {
      "id": "sec-06",
      "name": "Graceful Shutdown Context Cancellation",
      "status": "enforced",
      "tool": "ast-lint",
      "verify": "grep -q 'ShutdownWithContext' starter/main.go"
    },
    {
      "id": "sec-07",
      "name": "Max Request Body Size Limit Configuration",
      "status": "enforced",
      "tool": "fiber-lint",
      "verify": "grep -q 'BodyLimit' starter/main.go"
    },
    {
      "id": "sec-08",
      "name": "HTTP Liveness & Readiness Health Probes",
      "status": "enforced",
      "tool": "health-check",
      "verify": "grep -q '/health' starter/main.go"
    },
    {
      "id": "sec-09",
      "name": "Panic Recovery Middleware Invariant",
      "status": "enforced",
      "tool": "middleware-audit",
      "verify": "grep -q 'recover.New()' starter/main.go"
    },
    {
      "id": "sec-10",
      "name": "PostgreSQL PGX Connection Pool Configuration",
      "status": "enforced",
      "tool": "db-lint",
      "verify": "grep -q 'DATABASE_URL' starter/.env.example"
    },
    {
      "id": "sec-11",
      "name": "Structured Request Logging Middleware",
      "status": "enforced",
      "tool": "log-audit",
      "verify": "grep -q 'logger.New()' starter/main.go"
    },
    {
      "id": "sec-12",
      "name": "Go Module Dependency CVE Audit",
      "status": "enforced",
      "tool": "govulncheck",
      "verify": "grep -q 'module' starter/go.mod"
    }
  ]
}