{
  "kit": "rust-axum-postgresql",
  "version": "1.0.0",
  "total_controls": 12,
  "categories": [
    {
      "name": "Memory Safety & Zero-Trust Rust Compiler Defenses",
      "controls": [
        {
          "id": "RUST-01",
          "name": "Zero unsafe code policy enforced via #![deny(unsafe_code)]",
          "status": "enforced",
          "rule": "rules/source/04-rust-security-and-input-validation.md"
        },
        {
          "id": "RUST-02",
          "name": "Strict Serde JSON deserialization with input length bounds",
          "status": "enforced",
          "test": "starter/src/handlers.rs"
        },
        {
          "id": "RUST-03",
          "name": "Compile-time query verification eliminating SQL injection vulnerabilities",
          "status": "enforced",
          "tool": "sqlx"
        }
      ]
    },
    {
      "name": "Database Hardening & Connection Protection",
      "controls": [
        {
          "id": "DB-01",
          "name": "Bounded connection pool limits via PgPoolOptions (max 25 connections)",
          "status": "enforced",
          "test": "starter/src/main.rs: PgPoolOptions"
        },
        {
          "id": "DB-02",
          "name": "Strict acquire timeout (3s) preventing connection starvation deadlocks",
          "status": "enforced",
          "test": "starter/src/main.rs: acquire_timeout"
        },
        {
          "id": "DB-03",
          "name": "Database-level primary key UUIDv4 and foreign key constraints",
          "status": "enforced",
          "migration": "starter/migrations/0001_init.sql"
        }
      ]
    },
    {
      "name": "Network & Middleware Security Layers",
      "controls": [
        {
          "id": "NET-01",
          "name": "Tower TimeoutLayer (15s) mitigating Slowloris and hung requests",
          "status": "enforced",
          "test": "starter/src/main.rs: TimeoutLayer"
        },
        {
          "id": "NET-02",
          "name": "Unified AppError boundary preventing database query disclosure",
          "status": "enforced",
          "test": "starter/src/handlers.rs: AppError"
        },
        {
          "id": "NET-03",
          "name": "Pagination bounds enforcement (clamp 1..100) preventing query DoS",
          "status": "enforced",
          "test": "starter/src/handlers.rs: list_items"
        }
      ]
    },
    {
      "name": "Container & Supply Chain Hardening",
      "controls": [
        {
          "id": "OPS-HLTH",
          "name": "Liveness probe health endpoint (/healthz) returning HTTP 200 OK",
          "status": "enforced",
          "endpoint": "GET /healthz"
        },
        {
          "id": "OPS-USER",
          "name": "Non-root execution inside multi-stage Alpine container (USER 10001:10001)",
          "status": "enforced",
          "docker": "starter/Dockerfile: USER 10001:10001"
        },
        {
          "id": "CI-SCAN",
          "name": "Gitleaks secret detection and cargo-audit vulnerability scanning",
          "status": "enforced",
          "workflow": ".github/workflows/security.yml"
        }
      ]
    }
  ]
}