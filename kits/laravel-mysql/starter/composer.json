{
  "name": "techtalks/laravel-mysql",
  "type": "project",
  "description": "Production Laravel 11/12 + MySQL 8.4 LTS Stack Kit.",
  "license": "MIT",
  "require": {
    "php": "^8.3 || ^8.4",
    "laravel/framework": "^11.0 || ^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php artisan test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
