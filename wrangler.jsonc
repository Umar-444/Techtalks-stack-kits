{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techtalks-stack-kits",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
